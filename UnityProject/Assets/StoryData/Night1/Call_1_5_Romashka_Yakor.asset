    speakerName: "\u041B\u0418\u0421\u0418\u041D\u0410 (\xAB\u0420\u043E\u043C\u0430\u0448\u043A\u0430\xBB)"
    speakerColor: {r: 0.94, g: 0.8, b: 0.82, a: 1}
    isItalic: 0
    subtitleText: "\u041C\u0430\u044F\u043A, \u044D\u0442\u043E \u0420\u043E\u043C\u0430\u0448\u043A\u0430.
      \u0412\u043E\u0435\u043D\u0432\u0440\u0430\u0447 \u041B\u0438\u0441\u0438\u043D\u0430.
      \u0421\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435 \u043C\u0435\u043D\u044F,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441 \u042F\u043A\u043E\u0440\u0435\u043C."
