  - nodeId: n01_boiko_ask
    speakerName: "\u0411\u041E\u0419\u041A\u041E (\xAB\u041A\u0443\u0437\u043D\u0438\u0446\u0430\xBB)"
    speakerColor: {r: 0.92, g: 0.72, b: 0.48, a: 1}
    isItalic: 0
    subtitleText: "\u041C\u0430\u044F\u043A, \u041A\u0443\u0437\u043D\u0438\u0446\u0430
      \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442. \u0421\u0442\u0430\u0440\u0448\u0438\u043D\u0430
      \u0411\u043E\u0439\u043A\u043E. \u041C\u043D\u0435 \u0431\u044B \u041A\u043E\u0431\u0440\u0443,
      \u0441\u044B\u043D\u043E\u043A. \u0423 \u043C\u0435\u043D\u044F \u043F\u043E
      \u043D\u0430\u043A\u043B\u0430\u0434\u043D\u043E\u0439 \u0442\u0440\u0438 \u044F\u0449\u0438\u043A\u0430
      \u0442\u0443\u0448\u0451\u043D\u043A\u0438, \u0430 \u043F\u043E \u0444\u0430\u043A\u0442\u0443
      \u0434\u0432\u0430, \u0438 \u044F \u0436\u0435\u043B\u0430\u044E \u0437\u043D\u0430\u0442\u044C,
      \u043A\u0442\u043E \u0438\u0437 \u043D\u0430\u0441 \u0441\u043E\u0448\u0451\u043B
      \u0441 \u0443\u043C\u0430 \u2014 \u044F \u0438\u043B\u0438 \u0431\u0443\u043C\u0430\u0433\u0430."
    voiceClip: {fileID: 0}
