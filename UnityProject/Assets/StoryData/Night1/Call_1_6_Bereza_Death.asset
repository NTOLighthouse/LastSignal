  - nodeId: n04_demin_voices
    speakerName: "\u0414\u0401\u041C\u0418\u041D (\xAB\u0411\u0435\u0440\u0451\u0437\u0430\xBB)"
    speakerColor: {r: 0.96, g: 0.78, b: 0.44, a: 1}
    isItalic: 0
    subtitleText: "\u0418 \u0435\u0449\u0451. \u0413\u043E\u043B\u043E\u0441\u0430
      \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439. \u041A\u043D\u0438\u0433\u0443
      \u043C\u043E\u0436\u043D\u043E \u0443\u043A\u0440\u0430\u0441\u0442\u044C,
      \u043F\u0430\u0440\u043E\u043B\u044C \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u0431\u0438\u0442\u044C.
      \u0410 \u0433\u043E\u043B\u043E\u0441\u2026 \u041A\u043E\u0431\u0440\u0430
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \xAB\u0420\u0430\u0431\u043E\u0442\u0430\u0439\u0442\u0435\xBB. \u0413\u0440\u043E\u043C
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B. \u0420\u043E\u043C\u0430\u0448\u043A\u0430
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \xAB\u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430\xBB. \u0415\u0441\u043B\u0438
      \u0420\u043E\u043C\u0430\u0448\u043A\u0430 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430
      \u0431\u044B\u0442\u044C \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0439 \u2014
      \u044D\u0442\u043E \u043D\u0435 \u0420\u043E\u043C\u0430\u0448\u043A\u0430.
      \u041F\u043E\u043D\u044F\u043B?"
