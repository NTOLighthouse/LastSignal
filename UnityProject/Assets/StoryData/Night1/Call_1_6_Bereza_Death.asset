  - nodeId: n02_demin_rule4
    speakerName: "\u0414\u0401\u041C\u0418\u041D (\xAB\u0411\u0435\u0440\u0451\u0437\u0430\xBB)"
    speakerColor: {r: 0.96, g: 0.78, b: 0.44, a: 1}
    isItalic: 0
    subtitleText: "\u0418 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u0435,
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435. \u0413\u0434\u0435
      \u0441\u0438\u0434\u0438\u0448\u044C \u2014 \u0432 \u044D\u0444\u0438\u0440
      \u043D\u0438 \u0441\u043B\u043E\u0432\u0430: \u043D\u0438 \u043A\u0432\u0430\u0434\u0440\u0430\u0442,
      \u043D\u0438 \u0434\u043E\u043C, \u043D\u0438 \u0443\u043B\u0438\u0446\u0443.
      \u0421\u0432\u043E\u0438 \u0442\u0432\u043E\u0439 \u0430\u0434\u0440\u0435\u0441
      \u0437\u043D\u0430\u044E\u0442, \u0430 \u0447\u0443\u0436\u0438\u043C \u043E\u043D
      \u043D\u0443\u0436\u0435\u043D \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F
      \u043E\u0434\u043D\u043E\u0433\u043E. \u0417\u0430\u043F\u043E\u043C\u043D\u0438\u043B?"
