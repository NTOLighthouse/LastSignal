  callId: 1.6
  callTitle: "1.6. \xAB\u0411\u0435\u0440\u0451\u0437\u0430\xBB. \u0422\u0440\u0435\u0442\u044C\u0435
    \u043F\u0440\u0430\u0432\u0438\u043B\u043E \u0438 \u0433\u0438\u0431\u0435\u043B\u044C
    \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0443\u0437\u043B\u0430"
  nightNumber: 1
