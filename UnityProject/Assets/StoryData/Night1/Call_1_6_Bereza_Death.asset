    logbookNoteToAdd: "\u041E\u0441\u043E\u0431\u0438\u0441\u0442\u044B \u0432 \u044D\u0444\u0438\u0440
      \u043D\u0435 \u0445\u043E\u0434\u044F\u0442. \u041F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
      \u043D\u043E\u0433\u0430\u043C\u0438 \u0438 \u0441 \u0431\u0443\u043C\u0430\u0433\u043E\u0439"
    flagToSet: 0
