  entryNodeId: n01_demin_rule3
  nodes:
  - nodeId: n01_demin_rule3
    speakerName: "\u0414\u0401\u041C\u0418\u041D (\xAB\u0411\u0435\u0440\u0451\u0437\u0430\xBB)"
    speakerColor: {r: 0.96, g: 0.78, b: 0.44, a: 1}
    isItalic: 0
    subtitleText: "\u041C\u0430\u044F\u043A, \u044F \u0411\u0435\u0440\u0451\u0437\u0430.
      \u041D\u0443 \u0447\u0442\u043E, \u043D\u0435 \u0443\u0441\u043D\u0443\u043B?
      \u0421\u043B\u0443\u0448\u0430\u0439 \u0442\u0440\u0435\u0442\u044C\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u043E.
      \u041E\u0441\u043E\u0431\u044B\u0439 \u043E\u0442\u0434\u0435\u043B, \u043A\u043E\u043D\u0442\u0440\u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0430,
      \u0432\u0441\u044F\u043A\u0438\u0435 \xAB\u044F \u043E\u0442 \u0441\u0430\u043C\u043E\u0433\u043E
      \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E\xBB \u2014 \u0432 \u044D\u0444\u0438\u0440
      \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u044F\u0442. \u041D\u0438\u043A\u043E\u0433\u0434\u0430.
      \u041E\u043D\u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u043D\u043E\u0433\u0430\u043C\u0438
      \u0438 \u0441 \u0431\u0443\u043C\u0430\u0433\u043E\u0439. \u0415\u0441\u043B\u0438
      \u043A\u0442\u043E-\u0442\u043E \u0432 \u043D\u0430\u0443\u0448\u043D\u0438\u043A\u0430\u0445
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0435\u0431\u0435 \xAB\u044D\u0442\u043E
      \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E, \u043D\u0438\u043A\u043E\u043C\u0443
      \u043D\u0435 \u0434\u043E\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0439\xBB
      \u2014 \u044D\u0442\u043E \u043D\u0435 \u043D\u0430\u0448. \u0417\u0430\u043F\u0438\u0448\u0438
      \u043D\u0430 \u043F\u043E\u043B\u044F\u0445."
    voiceClip: {fileID: 0}
    fallbackDuration: 0
    postLineDelay: 0.35
    conditionRequiredFlag: 0
