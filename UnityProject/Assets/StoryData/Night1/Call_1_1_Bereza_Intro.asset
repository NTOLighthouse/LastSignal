  - nodeId: ask_password
    speakerName: "\u0414\u0401\u041C\u0418\u041D (\xAB\u0411\u0435\u0440\u0451\u0437\u0430\xBB)"
    speakerColor: {r: 0.96, g: 0.78, b: 0.44, a: 1}
    subtitleText: "\u0412\u0435\u0440\u043D\u043E, \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0430.
      \u041F\u0435\u0440\u0432\u043E\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u043E:
      \u043D\u0435\u0442 \u0432 \u043A\u043D\u0438\u0433\u0435 \u2014 \u043D\u0435\u0442
      \u0432 \u044D\u0444\u0438\u0440\u0435. \u0412\u0442\u043E\u0440\u043E\u0435:
      \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F \u2014
      \u0441\u043F\u0440\u043E\u0441\u0438 \u043F\u0430\u0440\u043E\u043B\u044C.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0430\u0440\u043E\u043B\u044C
      [\u041E\u043B\u044C\u0445\u0430|pwd_olha_n1]. \u0413\u043B\u044F\u043D\u044C
      \u0432 \u0442\u0430\u0431\u043B\u0438\u0446\u0443 \u043D\u0430 \u0420\u0430\u0437\u0432\u043E\u0440\u043E\u0442\u0435
      II (A/D \u0438\u043B\u0438 \u0437\u0430\u043A\u043B\u0430\u0434\u043A\u0430),
      \u0430 \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u043F\u0440\u043E\u0441\u0438
      \u043C\u0435\u043D\u044F."
