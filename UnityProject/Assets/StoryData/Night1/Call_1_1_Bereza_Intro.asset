  - nodeId: n04_demin_book
    speakerName: "\u0414\u0401\u041C\u0418\u041D (\xAB\u0411\u0435\u0440\u0451\u0437\u0430\xBB)"
    speakerColor: {r: 0.96, g: 0.78, b: 0.44, a: 1}
    isItalic: 0
    subtitleText: "\u0418 \u0443\u0447\u0442\u0438: \u043D\u0430\u0441 \u043D\u0430
      \u0432\u0435\u0441\u044C \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u0434\u0432\u043E\u0435
      \u0438 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u2014 \u044F \u0434\u0430
      \u0442\u044B. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0443\u0437\u043B\u044B
      \u0437\u0430\u0440\u0435\u0447\u043D\u044B\u0435 \u0432\u044B\u0431\u0438\u043B\u0438
      \u0437\u0430 \u043D\u0435\u0434\u0435\u043B\u044E: \u043F\u043E\u0439\u043C\u0430\u044E\u0442
      \u0433\u043E\u043B\u043E\u0441 \u0432 \u044D\u0444\u0438\u0440\u0435, \u0432\u044B\u0447\u0438\u0441\u043B\u044F\u0442,
      \u0433\u0434\u0435 \u0441\u0438\u0434\u0438\u0442 \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0447\u0438\u043A,
      \u2014 \u0438 \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0442\u0443\u0434\u0430
      \u043F\u0440\u0438\u043B\u0435\u0442\u0430\u0435\u0442. \u0422\u0435\u0431\u044F
      \u0443 \u043D\u0438\u0445 \u0432 \u0441\u043F\u0438\u0441\u043A\u0430\u0445
      \u043D\u0435\u0442, \u0442\u0432\u043E\u0439 \u043F\u043E\u0434\u0432\u0430\u043B
      \u0442\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438 \u043C\u043E\u043B\u0447\u0430\u043B.
      \u0412\u043E\u0442 \u0438 \u043D\u0435 \u0431\u043E\u043B\u0442\u0430\u0439
      \u043B\u0438\u0448\u043D\u0435\u0433\u043E. \u0415\u0441\u043B\u0438 \u0441\u043E
      \u043C\u043D\u043E\u0439 \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F,
      \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0435\u0442
      \u043D\u0435 \u0443 \u043A\u043E\u0433\u043E, \u0442\u0430\u043A \u0447\u0442\u043E
      \u0441\u043B\u0443\u0448\u0430\u0439 \u0438 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439.
      \u041A\u043D\u0438\u0433\u0443 \u0432\u0438\u0434\u0438\u0448\u044C? \u0421\u0435\u0440\u0430\u044F,
      \u0441\u043F\u0440\u0430\u0432\u0430. \u041E\u0442\u043A\u0440\u043E\u0439."
    voiceClip: {fileID: 0}
