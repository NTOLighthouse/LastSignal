    speakerName: "\u0414\u0401\u041C\u0418\u041D (\xAB\u0411\u0435\u0440\u0451\u0437\u0430\xBB)"
    speakerColor: {r: 0.96, g: 0.78, b: 0.44, a: 1}
    subtitleText: "\u041A\u0440\u0435\u043C\u0435\u043D\u044C. \u0412\u043E\u0442
      \u0442\u0430\u043A. \u041D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u043B\u0438
      \u2014 \u043A\u043B\u0430\u0434\u0438 \u0442\u0440\u0443\u0431\u043A\u0443,
      \u0445\u043E\u0442\u044C \u0442\u0430\u043C \u0441\u0430\u043C \u0433\u0435\u043D\u0435\u0440\u0430\u043B.
      \u0422\u0440\u0435\u0442\u044C\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u043E
      \u0441\u043A\u0430\u0436\u0443 \u043F\u043E\u0442\u043E\u043C, \u043E\u043D\u043E
      \u043D\u0435\u0432\u0435\u0441\u0451\u043B\u043E\u0435. \u0421\u0435\u0439\u0447\u0430\u0441
      \u043A \u0442\u0435\u0431\u0435 \u043F\u043E\u0439\u0434\u0443\u0442 \u043B\u044E\u0434\u0438.
      \u0420\u0430\u0431\u043E\u0442\u0430\u0439. \u041A\u043E\u043D\u0435\u0446
      \u0441\u0432\u044F\u0437\u0438."
