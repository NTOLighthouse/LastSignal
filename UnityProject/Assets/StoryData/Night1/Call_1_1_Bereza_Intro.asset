  - nodeId: explain_book
    speakerName: "\u0414\u0401\u041C\u0418\u041D (\xAB\u0411\u0435\u0440\u0451\u0437\u0430\xBB)"
    speakerColor: {r: 0.96, g: 0.78, b: 0.44, a: 1}
    subtitleText: "\u041E, \u0436\u0438\u0432\u043E\u0439 \u0433\u043E\u043B\u043E\u0441.
      \u0421\u0435\u0440\u0436\u0430\u043D\u0442 \u0414\u0451\u043C\u0438\u043D,
      \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0443\u0437\u0435\u043B.
      \u041D\u0430\u0441 \u043D\u0430 \u0432\u0435\u0441\u044C \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u0434\u0432\u043E\u0435 \u0438 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u2014 \u044F \u0434\u0430 \u0442\u044B. \u041A\u043D\u0438\u0433\u0443 \u0432\u0438\u0434\u0438\u0448\u044C?
      \u0421\u0435\u0440\u0430\u044F, \u0441\u043B\u0435\u0432\u0430. \u041E\u0442\u043A\u0440\u043E\u0439."
    voiceClip: {fileID: 0}
    fallbackDuration: 5.5
    postLineDelay: 0.35
    conditionRequiredFlag: 0
    conditionForbiddenFlag: 0
    skipToNodeId: 
    waitAction: 1
    expectedSubscriber: 0
    actionHintText: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u0441\u0435\u0440\u0443\u044E
