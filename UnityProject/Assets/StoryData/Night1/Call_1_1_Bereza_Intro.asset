      \u0441\u043F\u0440\u043E\u0441\u0438 \u043F\u0430\u0440\u043E\u043B\u044C.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0430\u0440\u043E\u043B\u044C
      \xAB\u041E\u043B\u044C\u0445\u0430\xBB. \u0422\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C
      \xAB\u041E\u043B\u044C\u0445\u0430\xBB, \u0442\u0435\u0431\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0442\u2026
