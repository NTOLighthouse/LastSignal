  - nodeId: find_romashka
    speakerName: "\u0414\u0401\u041C\u0418\u041D (\xAB\u0411\u0435\u0440\u0451\u0437\u0430\xBB)"
    speakerColor: {r: 0.96, g: 0.78, b: 0.44, a: 1}
    subtitleText: "\u0422\u0430\u043C \u0432\u0441\u0435, \u043A\u0442\u043E \u0438\u043C\u0435\u0435\u0442
      \u043F\u0440\u0430\u0432\u043E \u0442\u0435\u0431\u044F \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C.
      \u041F\u043E\u0437\u044B\u0432\u043D\u043E\u0439, \u043A\u0442\u043E \u0442\u0430\u043A\u043E\u0439,
      \u0433\u0434\u0435 \u0441\u0438\u0434\u0438\u0442. \u041D\u0430\u0439\u0434\u0438
      \u043C\u043D\u0435, \u043A\u0442\u043E \u0442\u0430\u043A\u0430\u044F \u0420\u043E\u043C\u0430\u0448\u043A\u0430."
    voiceClip: {fileID: 0}
    fallbackDuration: 4.2
    postLineDelay: 0.35
    conditionRequiredFlag: 0
    conditionForbiddenFlag: 0
    skipToNodeId: 
    waitAction: 2
    expectedSubscriber: 7
    actionHintText: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u0441\u0442\u0440\u043E\u043A\u0443 \xAB\u0420\u043E\u043C\u0430\u0448\u043A\u0430\xBB
