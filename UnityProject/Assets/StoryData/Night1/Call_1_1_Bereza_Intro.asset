  - nodeId: n03_demin_intro
    speakerName: "\u0414\u0401\u041C\u0418\u041D (\xAB\u0411\u0435\u0440\u0451\u0437\u0430\xBB)"
    speakerColor: {r: 0.96, g: 0.78, b: 0.44, a: 1}
    isItalic: 0
    subtitleText: "\u041E, \u0436\u0438\u0432\u043E\u0439 \u0433\u043E\u043B\u043E\u0441.
      \u0421\u0435\u0440\u0436\u0430\u043D\u0442 \u0414\u0451\u043C\u0438\u043D,
      \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0443\u0437\u0435\u043B.
      \u0410 \u0442\u044B, \u0441\u0442\u0430\u043B\u043E \u0431\u044B\u0442\u044C,
      \u0435\u0444\u0440\u0435\u0439\u0442\u043E\u0440 \u041B\u0430\u0440\u0438\u043D.
      \u041C\u0430\u0442\u0432\u0435\u0439, \u0442\u0430\u043A? \u0417\u0430\u043F\u043E\u043C\u043D\u0438,
      \u041C\u0430\u0442\u0432\u0435\u0439: \u0432 \u044D\u0444\u0438\u0440\u0435
      \u0442\u044B \u2014 \u041C\u0430\u044F\u043A, \u0438 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0438\u043A\u0442\u043E. \u0422\u044B \u0443 \u043D\u0430\u0441 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439,
      \u0442\u0430\u043A \u0447\u0442\u043E \u043D\u043E\u0447\u044C \u0431\u0443\u0434\u0435\u0442
      \u0441\u043A\u0443\u0447\u043D\u0430\u044F: \u0432\u0441\u0451 \u0438\u0434\u0451\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043C\u0435\u043D\u044F, \u0442\u0435\u0431\u0435
      \u2014 \u043A\u0440\u043E\u0448\u043A\u0438. \u041D\u043E \u043A\u0440\u043E\u0448\u043A\u0438
      \u0442\u043E\u0436\u0435 \u043D\u0430\u0434\u043E \u0443\u043C\u0435\u0442\u044C
      \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0442\u044C."
    voiceClip: {fileID: 0}
