  - nodeId: n01_kostrov_call
    speakerName: "\u041A\u041E\u0421\u0422\u0420\u041E\u0412 (\xAB\u0401\u0436\xBB)"
    speakerColor: {r: 0.76, g: 0.9, b: 0.64, a: 1}
    isItalic: 0
    subtitleText: "\u041C\u0430\u044F\u043A, \u041C\u0430\u044F\u043A, \u0401\u0436
      \u043D\u0430 \u0441\u0432\u044F\u0437\u0438! \u041B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442
      \u041A\u043E\u0441\u0442\u0440\u043E\u0432, \u0432\u044B\u0441\u043E\u0442\u0430
      \u0434\u0432\u0435\u0441\u0442\u0438 \u0447\u0435\u0442\u044B\u0440\u043D\u0430\u0434\u0446\u0430\u0442\u044C.
      \u0413\u0440\u043E\u043C \u043C\u043D\u0435 \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442,
      \u0443 \u043D\u0438\u0445, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
      \u043E\u043F\u044F\u0442\u044C \u0443\u0448\u0438 \u0437\u0430\u043B\u043E\u0436\u0438\u043B\u043E.
      \u041F\u0435\u0440\u0435\u0434\u0430\u0439 \u0438\u043C: \u043F\u0440\u0438\u0441\u0442\u0440\u0435\u043B\u043E\u0447\u043D\u044B\u0439,
      \u043A\u0432\u0430\u0434\u0440\u0430\u0442 [\u0448\u0435\u0441\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C-\u0411|sq_16b],
      [\u043E\u0434\u0438\u043D \u0441\u043D\u0430\u0440\u044F\u0434|ammo_1]. \u041A\u0430\u043A
      \u043F\u043E\u043D\u044F\u043B?"
    voiceClip: {fileID: 0}
