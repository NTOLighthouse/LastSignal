  - nodeId: n08_malcev_signal
    speakerName: "\u041C\u0410\u041B\u042C\u0426\u0415\u0412 (\xAB\u0428\u0438\u043B\u043E\xBB)"
    speakerColor: {r: 0.68, g: 0.84, b: 0.78, a: 1}
    isItalic: 1
    subtitleText: "\u0422\u0435\u043F\u0435\u0440\u044C \u0441\u043B\u0443\u0448\u0430\u0439
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E, \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C
      \u043D\u0435 \u0431\u0443\u0434\u0443. \u042F \u0438\u0434\u0443 \u0434\u0430\u043B\u0435\u043A\u043E.
      \u0415\u0441\u043B\u0438 \u043C\u0435\u043D\u044F \u0432\u043E\u0437\u044C\u043C\u0443\u0442
      \u2014 \u043F\u043E\u0441\u0430\u0434\u044F\u0442 \u043A \u0440\u0430\u0446\u0438\u0438
      \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u044F\u0442 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.
      \u0413\u043E\u043B\u043E\u0441 \u0431\u0443\u0434\u0435\u0442 \u043C\u043E\u0439,
      \u0441\u043B\u043E\u0432\u0430 \u2014 \u0438\u0445\u043D\u0438\u0435. \u0422\u0430\u043A
      \u0432\u043E\u0442. \u0415\u0441\u043B\u0438 \u044F \u0432 \u044D\u0444\u0438\u0440\u0435
      \u0441\u043A\u0430\u0436\u0443 \xAB\u043F\u043E\u0433\u043E\u0434\u0430 \u043B\u0451\u0442\u043D\u0430\u044F\xBB
      \u2014 \u0437\u043D\u0430\u0447\u0438\u0442, \u0443 \u043C\u0435\u043D\u044F
      \u0441\u0442\u0432\u043E\u043B \u0443 \u0437\u0430\u0442\u044B\u043B\u043A\u0430.
      \u0427\u0442\u043E \u0431\u044B \u044F \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E
      \u043D\u0438 \u0441\u043A\u0430\u0437\u0430\u043B \u2014 \u0432\u0441\u0451
      \u0432\u0440\u0430\u043D\u044C\u0451. \u0417\u0430\u043F\u043E\u043C\u043D\u0438\u043B?"
