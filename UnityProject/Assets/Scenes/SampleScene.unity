  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LastSignal.SwitchboardSystem.LogbookNotesPage
  pencilAnimator: {fileID: 7712617375345533464}
  rightPageRenderer: {fileID: 1881504221000015172}
  basePageTexture: {fileID: 2800000, guid: 8e1ea04ee72ba124d8fc772ccf7c79d3, type: 3}
  writeDurationPerNote: 1.35
  initialInstantNotes: []
  enableTestHotKey: 1
  presetNotes:
  - "\u041D\u0435\u0442 \u0432 \u043A\u043D\u0438\u0433\u0435 \u2014 \u043D\u0435\u0442
    \u0432 \u044D\u0444\u0438\u0440\u0435"
  - "\u041C\u043E\u0441\u0442: \xAB\u042F\u043A\u043E\u0440\u044E \u2014 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\xBB
    + \u043F\u0430\u0440\u043E\u043B\u044C \u0441\u0443\u0442\u043E\u043A"
  - "\u041E\u0441\u043E\u0431\u0438\u0441\u0442\u044B \u0432 \u044D\u0444\u0438\u0440
    \u043D\u0435 \u0445\u043E\u0434\u044F\u0442. \u041F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
    \u043D\u043E\u0433\u0430\u043C\u0438 \u0438 \u0441 \u0431\u0443\u043C\u0430\u0433\u043E\u0439"
  - "\u0421\u0432\u043E\u0439 \u0430\u0434\u0440\u0435\u0441 \u2014 \u0432 \u044D\u0444\u0438\u0440
    \u043D\u0438 \u0441\u043B\u043E\u0432\u0430. \u0427\u0443\u0436\u0438\u043C \u043D\u0443\u0436\u0435\u043D
    \u0434\u043B\u044F \u043E\u0434\u043D\u043E\u0433\u043E"
  - "\u041A\u043E\u0431\u0440\u0430 \u2014 \xAB\u0420\u0430\u0431\u043E\u0442\u0430\u0439\u0442\u0435\xBB.
    \u0413\u0440\u043E\u043C \u2014 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B.
    \u0420\u043E\u043C\u0430\u0448\u043A\u0430 \u2014 \xAB\u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430\xBB"
